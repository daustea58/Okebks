# ---------------------------------------------------------------------------
# Tempel semua baris berikut ke akhir file defconfig kernel surya
# (arch/arm64/configs/vendor/surya-stock_defconfig, atau nama yang sesuai
# hasil `ls arch/arm64/configs/vendor/ | grep -i surya`).
#
# Bisa juga disimpan sebagai fragment terpisah dan digabung otomatis di
# build.sh lewat: `cat configs/gaming_mode.config >> out/.config` lalu
# `make O=out olddefconfig` — lihat build.sh.
# ---------------------------------------------------------------------------

# --- Modules: dibutuhkan supaya MemKernel bisa dimuat sebagai .ko (LKM) ---
CONFIG_MODULES=y
CONFIG_MODULE_FORCE_LOAD=y
CONFIG_MODULE_UNLOAD=y
CONFIG_MODULE_SIG=n
CONFIG_MODULE_SIG_FORCE=n
CONFIG_MODULE_SIG_ALL=n
CONFIG_KPROBES=y
CONFIG_HAVE_KPROBES=y
CONFIG_KPROBE_EVENTS=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y

# --- Flag global game_mode (drivers/misc/game_mode.c) ---
CONFIG_GAME_MODE=y

# --- Governor gaming: schedhorizon ---
CONFIG_CPU_FREQ_GOV_SCHEDHORIZON=y
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDHORIZON=y

# --- I/O scheduler gaming: zen ---
CONFIG_IOSCHED_ZEN=y
CONFIG_DEFAULT_ZEN=y
  
